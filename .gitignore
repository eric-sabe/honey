# Scan output — a machine inventory; never publish.
runs/
latest

# Logs (contain hostnames and local paths).
*.log
cycle.log

# Machine-specific config written by setup.sh (e.g. a non-default BUMBLEBEE_REPO).
honey.conf

# Local secrets, if you ever add any (e.g. Slack webhook/token).
secrets.env
*.env

# macOS cruft.
.DS_Store

# Local Claude Code runtime artifacts (scheduler locks, etc.).
.claude/
